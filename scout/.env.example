# Soleil Scout — copy to .env and fill in. NEVER commit the filled version;
# this repo is public.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://ehlhlmbpwwalmeisvmdp.supabase.co
SUPABASE_ANON_KEY=
# Service role. Bypasses RLS — the ingest core scopes every write to one user.
SUPABASE_SERVICE_ROLE_KEY=

# ── PartyKit ────────────────────────────────────────────────────────────────
# The live Yjs peer, so cards land on an already-open canvas.
PARTYKIT_HOST=soleil-boards-party.arconkli.partykit.dev

# ── R2 ──────────────────────────────────────────────────────────────────────
# Same S3 credentials the seed scripts and party/upload.ts already use.
R2_ACCOUNT_ID=
R2_BUCKET=soleil-boards-images
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── Photon / Spectrum ───────────────────────────────────────────────────────
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# ── Workers AI ──────────────────────────────────────────────────────────────
# There is no `AI` binding outside a Worker, so this goes over REST. Two
# features depend on it and they degrade differently:
#
#   · intent extraction — blank is fine. Scout falls back to deterministic
#     intent, the board still works, and topics are labelled with the user's
#     own words. Filing works either way (see parseFileIntent).
#   · voice-note transcription — blank means NO TRANSCRIPT. The audio card
#     still lands and still plays; it just cannot be searched by what was said,
#     which is the whole reason voice notes are worth sending.
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# ── Behaviour ───────────────────────────────────────────────────────────────
APP_ORIGIN=https://clusters.soleilpictures.com
# How long to wait for a burst to settle. One attachment per message means a
# 12-photo dump is 12 messages; this is what makes it one reply.
SCOUT_BURST_MS=20000
# Per-identity rolling 24h ceiling. Abuse protection, NOT monetization — the
# card cap bounds a free account and does not bound a paid one at all.
SCOUT_DAILY_INGEST_MAX=500

# The invite drain — the only thing here that texts a stranger rather than
# answering someone who texted first. Set to 0 for ANY run that is not the
# deployed machine, or testing against the live line texts the real queue.
SCOUT_INVITES_ENABLED=1
