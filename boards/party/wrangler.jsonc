// The party Worker — see index.ts. Deployed by hand, not by Workers Builds:
//   cd boards && npm run deploy:party
// (wrangler 4; the repo's own wrangler is 3, which the main Worker's build
// still uses, so the scripts call wrangler@4 explicitly.)
//
// Secrets, the same five the PartyKit project held, set once with
//   npx -y wrangler@4.97.0 secret put <NAME> -c party/wrangler.jsonc
// SUPABASE_SERVICE_ROLE_KEY, R2_ACCOUNT_ID, R2_BUCKET, R2_ACCESS_KEY_ID,
// R2_SECRET_ACCESS_KEY.
//
// The Durable Object classes are SQLite-backed (new_sqlite_classes), which the
// board room's own copy of its document (roomLog.ts) needs. A migration tag is
// forever: add a new tag for a new class, never edit v1.
{
  "name": "soleil-boards-party",
  "main": "index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "SUPABASE_URL": "https://ehlhlmbpwwalmeisvmdp.supabase.co"
  },
  // Which deploy is answering, for the release a failure is recorded with
  // (report.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "Main", "class_name": "BoardParty" },
      { "name": "Workspace", "class_name": "WorkspaceParty" },
      { "name": "Universe", "class_name": "UniverseParty" },
      { "name": "Doc", "class_name": "DocParty" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardParty", "WorkspaceParty", "UniverseParty"] },
    // A shared doc's live room (party/doc.ts), 2026-10-18.
    { "tag": "v2", "new_sqlite_classes": ["DocParty"] }
  ]
}
