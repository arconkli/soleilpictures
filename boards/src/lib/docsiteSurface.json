    "router": [
      "changelogMatch = /^\\/changelog\\/?$/i.test(PATH)",
      "docsMatch = /^\\/docs(?:\\/|$)/i.test(PATH)",
      "exploreMatch = /^\\/explore\\/?$/.test(PATH)",
      "fileShareMatch = PATH.match(/^\\/f\\/([0-9a-f-]{36})\\/?$/i)",
      "keepMatch = PATH.match(/^\\/keep\\/([0-9a-f-]{36})\\/?$/i)",
      "legalMatch = PATH.match(/^\\/legal\\/(privacy|terms|cookies)\\/?$/i)",
      "makeMatch = /^\\/make\\/?$/i.test(PATH)",
      "oauthConsentMatch = /^\\/oauth\\/authorize\\/?$/i.test(PATH)",
      "pricingMatch = PATH.match(/^\\/pricing\\/?$/i)",
      "publicBoardMatch = PATH.match(/^\\/c\\/([a-z0-9][a-z0-9-]{0,79})\\/?$/)",
      "resumeMatch = /^\\/resume\\/?$/i.test(PATH)",
      "scoutMatch = /^\\/scout\\/?$/i.test(PATH)",
      "seoLandingMatch = /^\\/(?:tools\\/|vs\\/|use-cases(?:\\/|$)|templates(?:\\/|$))/i.test(PATH)",
      "seoListicleMatch = /^\\/best\\//i.test(PATH)",
      "shareMatch = PATH.match(/^\\/share\\/([0-9a-f-]{36})\\/?$/i)",
      "talkToUsMatch = /^\\/pricing\\/talk-to-us\\/?$/i.test(PATH)",
      "templateShareMatch = PATH.match(/^\\/t\\/([0-9a-f-]{36})\\/?$/i)"
    ]
  },
